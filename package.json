{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "lint:bruno": "eslint",
    "lint:bruno:fix": "eslint --fix",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new",
    "bruno:catalog": "node scripts/bruno-catalog/generate.mjs",
    "bruno:catalog:check": "node scripts/bruno-catalog/generate.mjs --check",
    "bruno:catalog:validate": "node scripts/bruno-catalog/validate.mjs"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@apidevtools/openapi-schemas": "^2.1.0",
    "@backstage/cli": "^0.36.4",
    "@backstage/cli-defaults": "^0.1.4",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@eslint/compat": "^1.3.2",
    "@eslint/js": "^9.39.5",
    "@jest/environment-jsdom-abstract": "~30.2.0",
    "@playwright/test": "^1.32.3",
    "@stylistic/eslint-plugin": "^5.3.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.39.0",
    "ajv-draft-04": "^1.0.0",
    "eslint": "^9.21.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "jest": "~30.2.0",
    "jsdom": "^27.1.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.13.0"
}
